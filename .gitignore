# Byte-compiled / optimized files
__pycache__/
*.py[cod]
*$py.class

# Packaging / build artifacts
build/
dist/
*.egg-info/
.eggs/
*.egg

# Virtual environments
.venv/
venv/
env/

# Test / coverage / type-checker caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# JAX / compilation caches
jax_cache/
.jax_cache/

# Combination outputs (e.g. *_result.txt written by the CLI)
*_result.txt

# Editor / OS cruft
.vscode/
.idea/
.DS_Store

# Reference documentation, not part of the package
documentation.pdf

# Run outputs, not source
out/
*.log
